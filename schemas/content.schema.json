{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dbp/content.schema.json",
  "title": "Деньги без паники — вход дизайн-завода",
  "type": "object",
  "required": ["date", "posts"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "format": "date"},
    "posts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot", "rubric", "card"],
        "properties": {
          "content_id": {"type": "string"},
          "slot": {"enum": ["morning", "day", "evening", "promo"]},
          "rubric": {"type": "string", "minLength": 1},
          "working_title": {"type": "string"},
          "card": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "subtitle": {"type": "string"},
              "badge": {"type": "string"},
              "points": {
                "type": "array",
                "maxItems": 3,
                "items": {"type": "string", "minLength": 1}
              },
              "footer": {"type": "string"}
            }
          },
          "image_prompt": {"type": "string"},
          "alt_text": {"type": "string", "maxLength": 140}
        }
      }
    }
  }
}
